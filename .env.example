# Neon Postgres (set automatically by the Vercel ↔ Neon integration)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# 32+ random characters, used to sign the session JWT
JWT_SECRET=change-me
# Vercel Blob read/write token (set automatically when a Blob store is connected).
# Without it, uploads fall back to inline data URLs (≤1 MB) – fine for local dev only.
BLOB_READ_WRITE_TOKEN=

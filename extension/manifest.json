{
  "manifest_version": 3,
  "name": "Anki-ji Capture",
  "short_name": "Anki-ji",
  "version": "1.0.0",
  "description": "Turn selected text on any page into an Anki-ji flashcard (AnkiConnect-compatible API).",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Add to Anki-ji", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A", "mac": "Alt+Shift+A" }, "description": "Add selection to Anki-ji" }
  }
}
